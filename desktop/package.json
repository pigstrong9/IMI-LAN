{
  "name": "imi-lan-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "IMI-LAN · 局域网直连桌面版",
  "author": "imi-lan",
  "productName": "IMI-LAN",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "probe": "electron . --probe",
    "pack:portable": "electron-packager . IMI-LAN --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --asar --ignore=node_modules --ignore=dist --ignore=probe.json --ignore=probe.png --ignore=engine.log"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "png-to-ico": "^3.0.2"
  }
}
