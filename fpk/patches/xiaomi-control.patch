+++ b/internal/xiaomi/ptz_test.go
@@ -0,0 +1,54 @@
+package xiaomi
+
+import "testing"
+
+// 桌面版没有网关按型号查 miot-spec 的能力。策略是 fail-open：
+// 只把已知的固定机 / 门铃藏起来，其余型号（包括未收录的新型号和没写
+// model= 的流）默认显示方向盘 —— 新设备不用改代码，按了没反应也只是
+// 提示一次。已知固定机 / 门铃仍然不显示。
+func TestBuildPTZSpec(t *testing.T) {
+	for _, model := range []string{
+		"", // 流地址里没有 model=，也按云台机处理
+		"chuangmi.camera.029a02",
+		"chuangmi.camera.039c01",
+		"chuangmi.camera.061a01",
+		"chuangmi.camera.81ac1",
+		"chuangmi.camera.12ab1",
+		"xiaovv.camera.q8",
+		"xiaovv.camera.fjcam3",
+		"chuangmi.camera.999",  // 未收录的新型号
+		"new.brand.camera.xyz", // 完全未知的品牌
+	} {
+		spec := buildPTZSpec(model)
+		if !spec.Supported || spec.Channel != "miss" {
+			t.Errorf("%q: want supported miss channel, got %+v", model, spec)
+		}
+		if len(spec.Dirs) != 4 {
+			t.Errorf("%q: want 4 dirs, got %v", model, spec.Dirs)
+		}
+		if spec.Note == "" {
+			t.Errorf("%q: want a note explaining the pad may do nothing", model)
+		}
+	}
+
+	for _, model := range []string{
+		"madv.cateye.mi3iot", // 门铃
+		"madv.cateye.mi2iot", // 门铃（同系列）
+		"mijia.camera.v3",    // 固定机
+	} {
+		spec := buildPTZSpec(model)
+		if spec.Supported || len(spec.Dirs) != 0 {
+			t.Errorf("%q: want fail-closed, got %+v", model, spec)
+		}
+		if spec.Note == "" {
+			t.Errorf("%q: want a note explaining why the pad is hidden", model)
+		}
+	}
+
+	if !ptzFixed("MADV.CATEYE.MI3IOT") {
+		t.Error("fixed model lookup should be case-insensitive")
+	}
+	if ptzFixed("chuangmi.camera.061a01") {
+		t.Error("a PTZ model must not be treated as fixed")
+	}
+}
