index 957c9d7..29a599f 100644
--- a/internal/xiaomi/xiaomi.go
+++ b/internal/xiaomi/xiaomi.go
@@ -8,6 +8,7 @@ import (
 	"fmt"
 	"net/http"
 	"net/url"
+	"strconv"
 	"strings"
 	"sync"
 
@@ -51,6 +52,256 @@ func Init() {
 	})
 
 	api.HandleFunc("api/xiaomi", apiXiaomi)
+	api.HandleFunc("api/xiaomi/command", apiCommand)
+	api.HandleFunc("/ptz/spec", apiPTZSpec)
+	api.HandleFunc("/ptz", apiPTZ)
+}
+
+// commandSender 由 pkg/xiaomi/miss.Producer 实现。
+type commandSender interface {
+	SendCommand(cmd uint32, payload []byte) ([]byte, error)
+}
+
+var (
+	errStreamNotFound = errors.New("stream not found")
+	errNoXiaomiCamera = errors.New("no Xiaomi camera is playing on this stream")
+)
+
+// sendStreamCommand 把一条 MISS 命令交给正在播放的连接。
+// 网关的 /api/xiaomi/command 和桌面版的 /ptz 共用这一条路径。
+func sendStreamCommand(src string, cmd uint32, payload string) ([]byte, error) {
+	stream := streams.Get(src)
+	if stream == nil {
+		return nil, errStreamNotFound
+	}
+
+	for _, conn := range stream.Conns() {
+		sender, ok := conn.(commandSender)
+		if !ok {
+			continue
+		}
+		return sender.SendCommand(cmd, []byte(payload))
+	}
+
+	return nil, errNoXiaomiCamera
+}
+
+// apiCommand 把一条原始 MISS 命令发给「正在播放」的小米摄像机，例如云台：
+//
+//	POST /api/xiaomi/command?src=camera1&cmd=0x112&data={"operation":1}
+//
+// operation 1/2/3/4 = 左/右/上/下，-1001 = 停止。摄像头只在视频连接里接受
+// 这类命令，所以 src 必须是当前正在播放的流；没有播放就返回 409。
+func apiCommand(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "", http.StatusMethodNotAllowed)
+		return
+	}
+
+	query := r.URL.Query()
+
+	// 保持原来的错误优先级：先确认流存在，再看 cmd 是否合法。
+	if streams.Get(query.Get("src")) == nil {
+		http.Error(w, errStreamNotFound.Error(), http.StatusNotFound)
+		return
+	}
+
+	cmd, err := strconv.ParseUint(query.Get("cmd"), 0, 32)
+	if err != nil {
+		http.Error(w, "wrong cmd", http.StatusBadRequest)
+		return
+	}
+
+	reply, err := sendStreamCommand(query.Get("src"), uint32(cmd), query.Get("data"))
+	if err != nil {
+		switch {
+		case errors.Is(err, errStreamNotFound):
+			http.Error(w, err.Error(), http.StatusNotFound)
+		case errors.Is(err, errNoXiaomiCamera):
+			http.Error(w, err.Error(), http.StatusConflict)
+		default:
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+		}
+		return
+	}
+
+	api.ResponseJSON(w, map[string]any{
+		"ok":    true,
+		"reply": string(reply),
+		"hex":   hex.EncodeToString(reply),
+	})
+}
+
+// ---------------------------------------------------------------- 桌面版云台
+//
+// 桌面版（Electron）不启动 imi-gateway，UI 由 go2rtc 的 static_dir 直接提供，
+// 所以这里补一份响应结构与网关 /ptz、/ptz/spec 相同的实现。
+//
+// 能力判定 fail-open：只有已知的固定机 / 门铃（madv.cateye.* 门铃、
+// mijia.camera.v3 固定机）不显示方向盘；其余型号——包括未收录的新型号和
+// 没写 model= 的流——默认按云台机处理。这样新设备不用改代码，代价是
+// 固定机上按了可能没反应（界面会提示一次，不会一直刷）。
+var ptzFixedModels = map[string]bool{
+	"mijia.camera.v3": true, // 米家智能摄像机 1080P（固定机）
+}
+
+var (
+	ptzDirs = []string{"left", "right", "up", "down"}
+	// MISS 0x112 电机命令：1=左 2=右 3=上 4=下，-1001=停止。
+	ptzOps = map[string]int{"left": 1, "right": 2, "up": 3, "down": 4}
+)
+
+const (
+	ptzMissCmd = 0x112
+	ptzStopOp  = -1001
+)
+
+type ptzSpec struct {
+	Model      string   `json:"model"`
+	Siid       int      `json:"siid"`
+	Aiid       int      `json:"aiid"`
+	Piid       int      `json:"piid"`
+	Format     string   `json:"format"`
+	Action     string   `json:"action"`
+	Source     string   `json:"source"`
+	Note       string   `json:"note,omitempty"`
+	Dirs       []string `json:"dirs"`
+	Supported  bool     `json:"supported"`
+	PTZCapable bool     `json:"ptzCapable"`
+	Channel    string   `json:"channel,omitempty"`
+}
+
+// streamModel 从流的原始地址里取 model= 参数（添加摄像头时由 go2rtc 写入）。
+func streamModel(name string) string {
+	stream := streams.Get(name)
+	if stream == nil {
+		return ""
+	}
+	for _, source := range stream.Sources() {
+		u, err := url.Parse(source)
+		if err != nil {
+			continue
+		}
+		if model := u.Query().Get("model"); model != "" {
+			return model
+		}
+	}
+	return ""
+}
+
+// ptzFixed 判断已知没有云台的型号。门铃统一是 madv.cateye.*；
+// 其余只在明确知道是固定机时才列进来，避免把新型号误判成固定机。
+func ptzFixed(model string) bool {
+	m := strings.ToLower(strings.TrimSpace(model))
+	if m == "" {
+		return false
+	}
+	return ptzFixedModels[m] || strings.HasPrefix(m, "madv.cateye.")
+}
+
+func buildPTZSpec(model string) *ptzSpec {
+	spec := &ptzSpec{Model: model}
+	if ptzFixed(model) {
+		spec.Note = "该型号是固定机/门铃，没有云台，不显示方向盘"
+		return spec
+	}
+	spec.Supported = true
+	spec.PTZCapable = true
+	spec.Channel = "miss"
+	spec.Source = "miss"
+	spec.Action = "MISS 0x112 motor"
+	spec.Dirs = ptzDirs
+	if model == "" {
+		spec.Note = "流地址里没有型号信息，仍显示方向盘；画面不动说明这台不是云台机或已到角度极限"
+	} else {
+		spec.Note = "型号未单独适配，默认显示方向盘；画面不动说明这台不是云台机或已到角度极限"
+	}
+	return spec
+}
+
+// apiPTZSpec 查询某个画面能不能控云台，响应结构与网关 /ptz/spec 对齐。
+func apiPTZSpec(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet && r.Method != http.MethodPost {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+
+	q := r.URL.Query()
+	name := strings.TrimSpace(q.Get("name"))
+	model := streamModel(name)
+
+	api.ResponseJSON(w, map[string]any{
+		"ok":    true,
+		"did":   q.Get("did"),
+		"name":  name,
+		"model": model,
+		"spec":  buildPTZSpec(model),
+	})
+}
+
+// apiPTZ 执行云台指令，响应结构与网关 /ptz 对齐。
+func apiPTZ(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet && r.Method != http.MethodPost {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+
+	q := r.URL.Query()
+	name := strings.TrimSpace(q.Get("name"))
+	move := strings.ToLower(strings.TrimSpace(q.Get("move")))
+	model := streamModel(name)
+
+	writeErr := func(status int, msg string) {
+		w.Header().Set("Content-Type", api.MimeJSON)
+		w.WriteHeader(status)
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"ok": false, "error": msg, "name": name, "move": move,
+			"model": model, "channel": "miss", "dirs": ptzDirs,
+		})
+	}
+
+	if move == "" {
+		writeErr(http.StatusBadRequest, "缺少 move")
+		return
+	}
+	if name == "" {
+		writeErr(http.StatusBadRequest, "缺少 name（画面名），命令发不到摄像机")
+		return
+	}
+
+	op := ptzStopOp
+	if move != "stop" {
+		// 与 /ptz/spec 同一套判定：已知固定机 / 门铃不发转动指令；
+		// 其余型号（包括未收录的新型号）都允许试一次。
+		if ptzFixed(model) {
+			writeErr(http.StatusNotImplemented, "该型号是固定机/门铃，没有云台")
+			return
+		}
+		var ok bool
+		if op, ok = ptzOps[move]; !ok {
+			writeErr(http.StatusBadRequest, fmt.Sprintf("云台只有上下左右四个方向，没有「%s」", move))
+			return
+		}
+	}
+
+	payload := fmt.Sprintf(`{"operation":%d}`, op)
+	reply, err := sendStreamCommand(name, ptzMissCmd, payload)
+	if err != nil {
+		switch {
+		case errors.Is(err, errStreamNotFound):
+			writeErr(http.StatusNotFound, "播放引擎里没有这个画面")
+		case errors.Is(err, errNoXiaomiCamera):
+			writeErr(http.StatusConflict, "画面还没连上摄像机，等画面出来再控制云台")
+		default:
+			writeErr(http.StatusBadGateway, err.Error())
+		}
+		return
+	}
+
+	api.ResponseJSON(w, map[string]any{
+		"ok": true, "channel": "miss", "name": name, "move": move,
+		"model": model, "data": payload, "reply": string(reply),
+	})
 }
 
