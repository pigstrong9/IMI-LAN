+// WriteCommandFast 只把命令塞进 socket，不等对端 ACK。
+//
+// WriteCommand 在 UDP 下要等 ACK，等不到就每秒重发一次、连发 5 次才返回
+// —— 单条命令最多阻塞 5 秒。这对「请求/响应」型命令是对的，但云台这类
+// 「持续朝某方向转」的指令是幂等的：摄像机根本不回 ACK，于是每条云台命令
+// 都要卡满 5 秒，上层 HTTP（网关 6 秒）直接超时。命令其实早就到了，用户
+// 看到的是假失败。云台命令丢一条也不致命 —— 按住时前端每 700ms 会补发。
+func (c *Conn) WriteCommandFast(cmd uint32, data []byte) error {
+	c.cmdMu.Lock()
+	defer c.cmdMu.Unlock()
+
+	req := marshalCmd(0, c.seqCh0, cmd, data)
+	c.seqCh0++
+
+	_, err := c.Conn.Write(req)
+	return err
