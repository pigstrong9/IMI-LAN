 type Client struct {
 	Conn
 	key   []byte
 	model string
+
+	replies   chan []byte
+	sendMu    sync.Mutex
+	done      chan struct{}
+	closeOnce sync.Once
+}
+
+// Close 停掉常驻的命令通道读取协程，再关闭底层连接。
+// go2rtc 在流停止或重连时会调用 Producer.Stop -> core.Connection.Stop -> Client.Close，
+// 这样 drainReplies 才能跟着连接一起退出，不会泄漏 goroutine。
+func (c *Client) Close() error {
+	c.closeOnce.Do(func() { close(c.done) })
+	return c.Conn.Close()
 }
 
