@@ -134,6 +155,106 @@ func (c *Client) WriteCommand(data []byte) error {
 	return c.Conn.WriteCommand(cmdEncoded, data)
 }
 
+// SendCommand 发一条 MISS 命令（例如云台的 cmdMotorReq）。
+//
+// 走「快写」通道：不等 ACK。cs2 的 WriteCommand 在 UDP 下等不到 ACK 会每秒
+// 重发、连发 5 次才返回，而摄像机对云台这类持续指令并不回 ACK —— 结果是每条
+// 命令卡 5 秒，上层 HTTP 早就超时了（命令其实已经到了）。
+//
+// wait > 0 时才顺手收一条回复（调试用）。wait = 0 表示发完就返回。
+func (c *Client) SendCommand(cmd uint32, payload []byte, wait time.Duration) ([]byte, error) {
+	select {
+	case <-c.done:
+		return nil, errors.New("miss: connection closed")
+	default:
+	}
+
+	c.sendMu.Lock()
+	defer c.sendMu.Unlock()
+
+	// 丢掉上一条超时之后才到的旧回复，否则这次会立刻拿到上一次的结果
+	for len(c.replies) > 0 {
+		<-c.replies
+	}
+
+	data := binary.BigEndian.AppendUint32(nil, cmd)
+	data = append(data, payload...)
+	if err := c.writeFast(data); err != nil {
+		return nil, err
+	}
+
+	if wait <= 0 {
+		return nil, nil
+	}
+
+	select {
+	case reply := <-c.replies:
+		return reply, nil
+	case <-time.After(wait):
+		return nil, nil
+	}
+}
+
+// writeFast 加密后直塞 socket。cs2 支持「不等 ACK」的写就优先用它；
+// 其它 transport（tutk）没有这个能力，退回普通写。
+func (c *Client) writeFast(data []byte) error {
+	data, err := crypto.Encode(data, c.key)
+	if err != nil {
+		return err
+	}
+	if w, ok := c.Conn.(interface {
+		WriteCommandFast(cmd uint32, data []byte) error
+	}); ok {
+		return w.WriteCommandFast(cmdEncoded, data)
+	}
+	return c.Conn.WriteCommand(cmdEncoded, data)
+}
+
+// Replies 暴露命令通道上读到的消息（调试用）。
+func (c *Client) Replies() <-chan []byte {
+	return c.replies
+}
+
+// drainReplies 常驻排空命令通道。
+//
+// 注意 ReadCommand 是「非阻塞取一条」而不是「阻塞等下一条」：通道里没东西时
+// 它立刻返回 io.EOF。所以这里必须自己睡一下再取，否则循环第一次就退出了
+// —— 那样通道没人排空，缓冲(10)满了 cs2 会判连接失效，C700 上就是每 110 秒
+// 断流一次。
+func (c *Client) drainReplies() {
+	for {
+		select {
+		case <-c.done:
+			return
+		default:
+		}
+
+		cmd, data, err := c.Conn.ReadCommand()
+		if err == nil {
+			// 写 cmd 用 BigEndian、读用 LittleEndian，所以两种字节序都要认
+			if (cmd == cmdEncoded || bits.ReverseBytes32(cmd) == cmdEncoded) && len(data) > 8 {
+				if decoded, err := crypto.Decode(data, c.key); err == nil {
+					data = decoded
+				}
+			}
+			select {
+			case c.replies <- data:
+			default:
+				// 没人取就丢，绝不能阻塞在这里 —— 阻塞了通道又会积压
+			}
+			continue
+		}
+
+		// 拿不到数据不等于连接断了，但也不能在死连接上 50Hz 空转。
+		// 等一会儿再试；连接真正关闭时 done 会被 Close 关掉，这里立即退出。
+		select {
+		case <-c.done:
+			return
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
+
