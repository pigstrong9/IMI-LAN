+// NewCloudWithCredentials 直接用扫码时保存的完整云端凭据构造会话，
+// 不再请求 account.xiaomi.com。凭据来自扫码那一刻的正版浏览器会话，
+// 风控模型不会把它当作可疑的二次登录。
+func NewCloudWithCredentials(sid, userID, cUserID, serviceToken string, ssecurity []byte) *Cloud {
+	c := NewCloud(sid)
+	c.userID = userID
+	c.cookies = fmt.Sprintf("userId=%s; cUserId=%s; serviceToken=%s", userID, cUserID, serviceToken)
+	c.ssecurity = ssecurity
+	return c
+}
+
+// HasServiceToken 登录流程（finishAuth）结束后 serviceToken 是否已拿到。
+// 为空说明小米返回 70016 要求二次验证，此时必须重新扫码。
+func (c *Cloud) HasServiceToken() bool {
+	for _, kv := range strings.Split(c.cookies, "; ") {
+		if strings.HasPrefix(kv, "serviceToken=") && len(kv) > len("serviceToken=") {
+			return true
+		}
+	}
+	return false
+}
