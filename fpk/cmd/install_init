#!/bin/bash
# 安装前检查：本包只提供 x86_64 二进制
set -u

case "${TRIM_SYS_ARCH:-}" in
    x86_64|amd64)
        exit 0
        ;;
    *)
        if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
            echo "IMI-LAN 目前只提供 x86_64 安装包，当前系统架构为 ${TRIM_SYS_ARCH:-未知}。" > "${TRIM_TEMP_LOGFILE}"
        fi
        exit 1
        ;;
esac
